# Generated FPGA/SDK intermediates and captures (bitstreams / ELFs are versioned)
build/**
!build/**/
results/
releases/**
!releases/**/
*.bit
*.elf
*.dcp
*.vvp
*.kvdat
*.csv
*.bin
*.log
.vivado/
.Xil/

# Local experiments and third-party reference trees
NA/
reference/
firmware/cdc_bench/
firmware/xusbps_cdc/
firmware/xusbps_composite_bench/
firmware/xusbps_daplink/
usage_statistics_webtalk.*
resultsdaplinksanity.bin
__pycache__/
*.pyc

# Prebuilt release binaries are part of the repository
!prebuilt/
!prebuilt/*.bit
!prebuilt/*.elf
!prebuilt/**/*.bit
!prebuilt/**/*.elf

# FPGA bitstreams and Zynq firmware ELFs must be eligible for Git tracking,
# including artifacts kept under build/ and releases/. Keep intermediate
# files ignored; select the validated artifact pair explicitly when committing.
!build/**/*.bit
!build/**/*.elf
!releases/**/*.bit
!releases/**/*.elf

# Target firmware ELFs are shipped (avoid rebuilding)
!firmware/target/stm32f103_scope/build-cb/fw.elf
!firmware/target/stm32f103_scope/build-cb-60mhz/fw.elf
!firmware/target/stm32f103_scope/build-cb-64mhz/fw.elf
!firmware/target/stm32f103_scope/build-cb-72mhz/fw.elf

# STM32F103ZE scope firmware (96 MHz, JTAG kept enabled) is shipped
!firmware/target/stm32f103_scope/build/fw.elf
!firmware/target/stm32f103_scope/build/fw.hex
