    {
      "id": "f103ze-sram-rtt-scope",
      "board": "f103ze",
      "feature": "sram-rtt-scope",
      "role": "regular",
      "title": "F103ZE SRAM、RTT、J-Scope 和并发",
      "entry": "board.accept",
      "args": [
        "--selectio",
        "--board",
        "f103ze",
        "--pair",
        "{pair}",
        "--only",
        "memory",
        "--only",
        "rtt",
        "--only",
        "scope",
        "--only",
        "combo",
        "--out",
        "<new-output>"
      ],
      "probePair": "f103-cdc-abi1",
      "targetElf": "prebuilt/golden/f103ze-cdc48.elf",
      "evidence": [
        "docs/validation/spi-cdc-20261123/README.md"
      ],
      "note": "CDC48 和已验证的 ABI 1 配对。临时 SRAM 夹具由脚本准备。RAW4 ABI 2 结果另计。"
    },
    {
      "id": "h743-sram-rtt-scope",
